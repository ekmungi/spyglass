# Spyglass repo ignores: keep the tree clean and deterministic.

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
frontend/dist/
frontend/coverage/
plugin/dist/
*.tsbuildinfo

# Installer build: the pinned uv.exe is copied in at build time, and the compiler writes Output/
installer/uv.exe
# The launcher that installer\build_launcher.ps1 compiles for every build.
installer/Spyglass.exe
# The MSI's helper program that installer\build_setup_helper.ps1 compiles for every build.
installer/SpyglassSetup.exe
installer/Output/
# What installer/harvest.py writes for each MSI build.
installer/obj/

# Local plan files are never committed (user rule)
PLAN.md
plan.md

# Session and tooling artifacts
.claude/
.superpowers/
.remember/
.vault-cache/
*.log
.env
.data/
