# Spyglass service configuration. Copy to .env (gitignored) and fill in.
# All settings can also be set as environment variables with the same names.

# Where briefings and research notes are written (your Obsidian vault root).
SPYGLASS_VAULT_PATH=C:/path/to/your/vault

# Vault note listing RSS feed URLs (editable from Obsidian desktop and mobile).
SPYGLASS_FEED_NOTE_PATH=C:/path/to/your/vault/03 RESOURCES/Research/Spyglass/feeds.md

# Vault note describing your interests (read by Claude on every curation run).
SPYGLASS_INTEREST_NOTE_PATH=C:/path/to/your/vault/03 RESOURCES/Research/Spyglass/interests.md

# Raindrop personal test token (Settings -> Integrations -> For Developers).
# Leave unset to disable Raindrop collection.
SPYGLASS_RAINDROP_TOKEN=

# OpenRouter API key -- powers the enrichment pipeline (relevance scoring + article
# summaries via the configured model). The plain OPENROUTER_API_KEY name is read too, so an
# existing OpenRouter key works as is. Leave unset to disable enrichment (collection still works).
OPENROUTER_API_KEY=

# Optional overrides.
# SPYGLASS_PORT=7777
# SPYGLASS_STALE_HOURS=6
# SPYGLASS_BRIEFING_SUBDIR=03 RESOURCES/Research/Spyglass
# SPYGLASS_ENRICH_MODEL=deepseek/deepseek-v4-flash   # OpenRouter model for enrichment
# SPYGLASS_RELEVANCE_GATE=40                          # 0-100; below this, an item is not fetched/summarized
