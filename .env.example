# Spyglass settings. Copy this file to .env (it is gitignored) and uncomment what you need.
# Every line is optional: Spyglass runs with the defaults shown. Most settings can also be
# changed in the app (Settings), which saves them for you; a value set here is the starting
# point. Each name takes the SPYGLASS_ prefix, and a key may also be read under its usual name
# (for example OPENROUTER_API_KEY).

# --- Where the service listens ---------------------------------------------------------------
# Port on this computer; by default only this computer can connect.
# SPYGLASS_PORT=7777

# --- Where your data lives -------------------------------------------------------------------
# Folder for the database, backups and caches. Keep it out of a cloud-synced folder: a live
# database in one can be corrupted. Default: a ".spyglass" folder in your home folder.
# SPYGLASS_DATA_DIR=C:/path/to/data

# --- AI engine for judging and writing -------------------------------------------------------
# Who judges and writes: openrouter (pay per use), claude_code (your own Claude Code, on your
# plan), gemini or antigravity.
# SPYGLASS_RADAR_LLM_PROVIDER=openrouter
# Engines to try, in order, when the first is unavailable (out of credit, limit reached, not
# signed in). Comma-separated names from the list above; empty means no fallback.
# SPYGLASS_RADAR_LLM_FALLBACK=

# --- Keys (leave empty to leave an engine off) -----------------------------------------------
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Daily brief and collection --------------------------------------------------------------
# Local time of day when the brief is composed (HH:MM).
# SPYGLASS_RADAR_BRIEF_TIME=06:30
# Time zone for the brief day and schedule, for example Europe/Berlin. Empty uses this
# computer's own zone.
# SPYGLASS_RADAR_TIMEZONE=
# Hours between automatic collections while the service runs.
# SPYGLASS_RADAR_COLLECT_HOURS=2.0

# --- Privacy ---------------------------------------------------------------------------------
# Send the titles of items you saved or rejected to the judging model as examples of your taste.
# SPYGLASS_PRIVACY_SEND_EXAMPLES=true
# Load article images through this service, so your browser never contacts the sites hosting them.
# SPYGLASS_PRIVACY_PROXY_IMAGES=true
# Let the built-in invisible browser pass a site's automated bot check (no login, nothing personal).
# SPYGLASS_PRIVACY_ALLOW_BOT_CHECKS=true

# --- Capture: bringing in what you read elsewhere ----------------------------------------------
# Raindrop test token (Raindrop settings, Integrations, For Developers).
# SPYGLASS_RAINDROP_TOKEN=
# Slack bot token and the id of the channel you post links into.
# SPYGLASS_SLACK_BOT_TOKEN=
# SPYGLASS_SLACK_CAPTURE_CHANNEL=
# Slack app-level token: delivers a new message within seconds. Without it the channel is
# checked on a timer instead.
# SPYGLASS_SLACK_APP_TOKEN=
# Gmail over IMAP: the address, an app password, the label that marks newsletters, and the
# label for links you mail to yourself.
# SPYGLASS_GMAIL_ADDRESS=
# SPYGLASS_GMAIL_APP_PASSWORD=
# SPYGLASS_GMAIL_NEWSLETTER_LABEL=Newsletters
# SPYGLASS_GMAIL_CAPTURE_LABEL=Spyglass
# Seconds between checks of the capture sources when there is no live connection.
# SPYGLASS_RADAR_CAPTURE_POLL_SECONDS=60

# --- Notes vault (optional) --------------------------------------------------------------------
# The folder of your notes app, if you want Spyglass to write notes into it.
# SPYGLASS_VAULT_PATH=C:/path/to/notes

# --- Filing integration (optional) -------------------------------------------------------------
# The names of your own Claude Code filing plugin and skills; leave empty to keep filing hidden.
SPYGLASS_RADAR_FILING_PLUGIN=
SPYGLASS_RADAR_FILING_INGEST_SKILL=
SPYGLASS_RADAR_FILING_MANAGE_SKILL=
