{
  "manifest_version": 3,
  "name": "Send to Spyglass",
  "description": "Send the page you are reading, or the text you selected, to Spyglass on this computer. Only acts when you click.",
  "version": "0.40.0",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "notifications"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Send to Spyglass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "send-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Send this page to Spyglass"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
