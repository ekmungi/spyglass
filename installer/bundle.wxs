<?xml version="1.0" encoding="utf-8"?>
<!-- Spyglass-Setup-<version>.exe: a WiX setup program (a Burn bundle) around the MSI, built by
     installer\build_msi.ps1 after the MSI:
       wix build -arch x64 -ext WixToolset.Bal.wixext -d Version=0.42.0
                 -d MsiPath=installer\Output\Spyglass-0.42.0.msi
                 -o installer\Output\Spyglass-Setup-0.42.0.exe installer\bundle.wxs
     It shows the MSI's own pages, so the choices are the same. It is published only once a test
     install has shown that Spyglass appears in the Start menu at once with it, as with the MSI. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Spyglass" Manufacturer="ekmungi" Version="$(var.Version)"
          UpgradeCode="D08B3697-465B-4816-857D-DF5F3F033E07" IconSourceFile="installer\spyglass.ico"
          AboutUrl="https://github.com/ekmungi/spyglass">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              LicenseUrl="https://github.com/ekmungi/spyglass/blob/master/LICENSE" />
    </BootstrapperApplication>
    <Chain>
      <!-- The package installs for the current user only; its own pages ask what to install. -->
      <MsiPackage SourceFile="$(var.MsiPath)" bal:DisplayInternalUICondition="1" />
    </Chain>
  </Bundle>
</Wix>
